# Copy this file to ".env" and fill in real values. Never commit ".env".

# "demo" runs the whole architecture with deterministic mock LLM output
# (no API key needed). "openai" makes real calls to the OpenAI API.
LLM_PROVIDER=demo

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
